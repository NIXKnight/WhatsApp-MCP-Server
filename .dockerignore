# Root context is used only by session-controller/Dockerfile. Deny by default.
*

# Locked TypeScript controller build/runtime inputs.
!session-controller/
session-controller/*
!session-controller/package.json
!session-controller/package-lock.json
!session-controller/tsconfig.json
!session-controller/src/
!session-controller/src/**
!session-controller/config/
!session-controller/config/system-prompt.md
!session-controller/config/pre-compaction.md
!session-controller/config/compaction-summary.md

# Locked Python WhatsApp MCP stdio runtime inputs.
!mcp-server/
mcp-server/*
!mcp-server/pyproject.toml
!mcp-server/uv.lock
!mcp-server/src/
!mcp-server/src/**

# Terminal secret/state/build denies: no later negation may override these.
.git
.git/**
.rpiv
.rpiv/**
.env
.env.*
**/.env
**/.env.*
**/credentials/**
**/*credential*
**/*secret*
**/*token*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/auth.json
**/models.json
**/session.json
**/sessions/**
**/runtime/**
workspace
workspace/**
**/node_modules/**
**/dist/**
**/coverage/**
**/.cache/**
**/.pytest_cache/**
**/.ruff_cache/**
**/.vitest/**
**/*.tsbuildinfo
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.log
**/data/**
**/local-data/**
**/__pycache__/**
**/*.py[cod]
