# Go
bridge/data/*.db
bridge/data/media/
bridge/data/cooldown
*.exe
*.exe~
*.dll
*.so
*.dylib

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
*.egg-info/
.eggs/
.ruff_cache/
dist/
build/
# Host-native bridge release artifacts (explicit even though dist/ also matches).
/bridge/dist/
bridge/whatsapp-bridge
.playwright*

# Root operator environment is never committed; named templates remain allowed.
/.env
/.env.*
!/.env.example
!/.env.template

# Session controller build/test/runtime artifacts (package-lock.json is committed)
/session-controller/dist/
/session-controller/coverage/
/session-controller/.vitest/
/session-controller/node_modules/
/session-controller/*.tsbuildinfo
/session-controller/runtime/
/session-controller/sessions/
